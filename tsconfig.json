{
  "include": ["src/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "module": "commonjs",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  }
}
