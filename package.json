{
  "name": "@faubulous/mentor-cli",
  "version": "0.2.2",
  "description": "Mentor command line utilities to support continous integration (CI) tasks in RDF projects.",
  "private": false,
  "license": "GPL",
  "author": {
    "name": "Sebastian Faubel"
  },
  "bin": {
    "mentor-cli": "out/mentor-cli.js"
  },
  "files": [
    "out",
    "!out/**/*.map"
  ],
  "scripts": {
    "clean": "rimraf out test/*.ts",
    "build": "npm run clean && vite build",
    "build:prod": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build:prod"
  },
  "keywords": [
    "rdf",
    "generator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faubulous/mentor-cli.git"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "n3": "^2.13.12"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.5",
    "@types/node": "^26.6.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
